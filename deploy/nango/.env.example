# ── Nango secrets ──────────────────────────────────────────────────────────
# 32-byte key, base64-encoded. Generate with:
#   openssl rand -base64 32
# WARNING: key rotation is not supported — changing it later breaks decryption.
NANGO_ENCRYPTION_KEY=

# The API secret your backend uses (Authorization: Bearer <this>). Generate with:
#   openssl rand -hex 32
# Must NOT be a placeholder like "your_nango_secret_key".
NANGO_SECRET_KEY=

# ── Database (defaults are fine for dev) ─────────────────────────────────────
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango

# ── Public URLs (change for non-localhost deploys) ───────────────────────────
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009
