# ── Nango secrets ──────────────────────────────────────────────────────────
# 32-byte key, base64-encoded. Generate with:
#   openssl rand -base64 32
# WARNING: key rotation is not supported — changing it later breaks decryption.
NANGO_ENCRYPTION_KEY=

# NOTE: this env var does NOT seed the real API secret — Nango generates a
# random one per environment (table _nango_environments.secret_key) the
# first time you sign up in the dashboard, regardless of what's here. Set
# your consumer's NANGO_SECRET_KEY to whatever the dashboard actually shows
# for that environment, not to this value.
NANGO_SECRET_KEY=

# ── Database (defaults are fine for dev) ─────────────────────────────────────
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_NAME=nango

# ── Public URLs (change for non-localhost deploys) ───────────────────────────
# Behind the shared Traefik (see docker-compose.yaml labels), use the public
# https URLs instead, e.g. https://api.nango.yourdomain.com
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009
